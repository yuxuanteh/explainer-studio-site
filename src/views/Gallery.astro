---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { t, asset, specimenTypes, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const items = (await getCollection('specimens')).sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
const rendered = await Promise.all(items.map(async (s) => ({ s, Content: (await render(s)).Content })));
const usedTypes = (Object.keys(specimenTypes) as (keyof typeof specimenTypes)[]).filter((k) => items.some((s) => s.data.type === k));
---
<Base lang={lang} title={t(lang, 'gallery')} active="gallery">
  <section class="sec-dark section">
    <div class="wrap">
      <div class="sec-head">
        <div><h1 class="page-title">{t(lang, 'gallery')}</h1><p>{t(lang, 'gallerySub')}</p></div>
        {usedTypes.length > 1 && (
          <div class="chips" role="group" aria-label="Type">
            <button class="chip" type="button" data-filter="all" aria-pressed="true">{t(lang, 'all')}</button>
            {usedTypes.map((k) => <button class="chip" type="button" data-filter={k} aria-pressed="false">{specimenTypes[k][lang]}</button>)}
          </div>
        )}
      </div>

      {items.length === 0 && (
        <div class="empty">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l7 5-2.5 13h-9L5 7z"/><path d="M5 7h14M12 2l-3 5 3 13 3-13z"/></svg>
          <p>{t(lang, 'galleryEmpty')}</p>
        </div>
      )}

      <div class="masonry" id="gallery">
        {rendered.map(({ s, Content }, i) => (
          <figure class="item" data-type={s.data.type}>
            <button type="button" class="open" data-dialog={`spec-${i}`} aria-label={s.data.name}>
              <img src={asset(s.data.image)} alt={s.data.name} loading="lazy" />
            </button>
            <figcaption>
              <span class="name">{lang === 'en' && s.data.nameEn ? s.data.nameEn : s.data.name}</span>
              <span class="type">{specimenTypes[s.data.type][lang]}{s.data.location ? ` · ${s.data.location}` : ''}</span>
            </figcaption>
            <dialog id={`spec-${i}`} class="lightbox">
              <div class="lb-inner">
                <img src={asset(s.data.image)} alt={s.data.name} />
                <div class="lb-text">
                  <span class="tag">{specimenTypes[s.data.type][lang]}</span>
                  <h2>{s.data.name}{s.data.nameEn && lang === 'zh' ? ` ${s.data.nameEn}` : ''}</h2>
                  {s.data.location && <p class="loc">{t(lang, 'location')}：{s.data.location}</p>}
                  <div class="desc"><Content /></div>
                  <form method="dialog"><button class="btn btn-gold" type="submit">{t(lang, 'close')}</button></form>
                </div>
              </div>
            </dialog>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .empty { border: 1px dashed var(--line); border-radius: 16px; padding: 64px 24px; text-align: center; color: var(--muted); display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .masonry { columns: 3 280px; column-gap: 20px; }
  .item { break-inside: avoid; margin: 0 0 20px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .open { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .open img { width: 100%; height: auto; transition: transform .3s; }
  .open:hover img { transform: scale(1.03); }
  figcaption { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 4px; }
  .name { font-weight: 700; font-size: 17px; }
  .type { font-size: 13px; color: var(--muted); }
  .lightbox { border: 0; padding: 0; max-width: min(1100px, 94vw); width: 100%; background: var(--dark); color: var(--dark-text); border-radius: 16px; }
  .lightbox::backdrop { background: rgba(0,0,0,.85); }
  .lb-inner { display: flex; flex-wrap: wrap; }
  .lb-inner > img { flex: 2 1 420px; min-width: 0; max-height: 80vh; object-fit: contain; background: #0E0C06; }
  .lb-text { flex: 1 1 280px; padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .lb-text h2 { margin: 0; font-family: var(--font-cjk-serif); font-size: 26px; }
  .lb-text .tag { color: var(--gold); }
  .loc { margin: 0; color: var(--dark-muted); font-size: 14px; }
  .desc { line-height: 1.8; color: #E5DCC3; }
  .desc :global(p) { margin: 0 0 12px; }
  .lb-text form { margin-top: auto; }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('.open').forEach((b) =>
    b.addEventListener('click', () => (document.getElementById(b.dataset.dialog!) as HTMLDialogElement)?.showModal()));
  document.querySelectorAll<HTMLDialogElement>('.lightbox').forEach((d) =>
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); }));
  const chips = document.querySelectorAll<HTMLButtonElement>('.chips .chip');
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    document.querySelectorAll<HTMLElement>('#gallery [data-type]').forEach((it) => {
      it.hidden = c.dataset.filter !== 'all' && it.dataset.type !== c.dataset.filter;
    });
  }));
</script>
